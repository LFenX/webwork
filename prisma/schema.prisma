generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model JobApplication {
  id         String    @id @default(cuid())
  company    String
  position   String
  channel    String    @default("其他")
  appliedAt  DateTime  @default(now())
  status     String    @default("已投递")
  repliedAt  DateTime?
  notes      String?
  interviews InterviewRecord[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model InterviewRecord {
  id           String          @id @default(cuid())
  jobId        String?
  job          JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company      String
  position     String
  round        String          @default("技术一面")
  format       String          @default("视频")
  scheduledAt  DateTime        @default(now())
  interviewers String?
  questions    String?
  selfRating   Int?
  result       String          @default("待定")
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
