generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String   @default("")
  bio          String   @default("")
  avatarText   String   @default("")
  avatarUrl    String?
  location     String   @default("")
  role         String   @default("user")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  jobs         JobApplication[]
  interviews   InterviewRecord[]
  resume       Resume?
  settings     SiteSettings?
  moduleVisibilities ModuleVisibility[]
  visitsOwned  VisitLog[] @relation("visitOwner")
  visitsMade   VisitLog[] @relation("visitVisitor")
  comments     Comment[]
  activities   UserActivity[]
  passwordChangeRequests PasswordChangeRequest[]
  uploads      Upload[]
  sessions     UserSession[]
  articleFolders ArticleFolder[]
  resumeVersions ResumeVersion[]

  sentRequests     FriendRequest[] @relation("sent")
  receivedRequests FriendRequest[] @relation("received")
  friendshipsA     Friendship[]    @relation("a")
  friendshipsB     Friendship[]    @relation("b")

  guestbookOwned   GuestbookMessage[] @relation("guestbookOwner")
  guestbookWritten GuestbookMessage[] @relation("guestbookAuthor")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  ipAddress String   @default("")
  geoLocation String @default("")
  deviceInfo String  @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserSession {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("active")
  ipAddress          String   @default("")
  geoLocation        String   @default("")
  deviceInfo         String   @default("")
  replacedByLocation String   @default("")
  replacedByDevice   String   @default("")
  lastSeenAt         DateTime @default(now())
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([sessionId])
  @@index([lastSeenAt])
}

model RegistrationRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  status       String    @default("pending")
  approveToken String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?
}

model PasswordChangeRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash    String
  status          String    @default("pending")
  requestedAt     DateTime  @default(now())
  respondedAt     DateTime?
  approvedById    String?

  @@index([userId, status])
  @@index([status, requestedAt])
}

model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toUserId    String
  from        User      @relation("sent",     fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("received", fields: [toUserId],   references: [id], onDelete: Cascade)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("a", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("b", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model JobApplication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String
  position     String
  channel      String    @default("其他")
  appliedAt    DateTime  @default(now())
  status       String    @default("已投递")
  repliedAt    DateTime?
  notes        String?
  baseLocation String?
  hrContact    String?
  link         String?
  interviews   InterviewRecord[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model InterviewRecord {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company      String
  position     String
  round        String          @default("技术一面")
  format       String          @default("视频")
  scheduledAt  DateTime        @default(now())
  interviewers String?
  questions    String?
  selfRating   Int?
  result       String          @default("待定")
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model Post {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     ArticleFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  type       String
  slug       String
  title      String
  summary    String   @default("")
  tags       String   @default("[]")
  content    String   @default("")
  visibility String   @default("private")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]

  @@unique([userId, type, slug])
  @@index([userId, type, date])
  @@index([folderId])
}

model ArticleFolder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  name          String
  description   String   @default("")
  coverImageUrl String   @default("")
  coverPositionX Int     @default(50)
  coverPositionY Int     @default(50)
  coverOpacity   Int     @default(100)
  posts         Post[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, type])
}

model UpdateLogOverride {
  hash          String   @id
  customMessage String?
  useOriginal   Boolean  @default(true)
  hidden        Boolean  @default(false)
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model ModuleVisibility {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  visibility String   @default("private")
  updatedAt  DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

model VisitLog {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("visitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  visitorId String?
  visitor   User?    @relation("visitVisitor", fields: [visitorId], references: [id], onDelete: SetNull)
  module    String
  path      String
  postId    String?
  createdAt DateTime @default(now())

  @@index([ownerId, module, createdAt])
  @@index([visitorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

model Resume {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("markdown")
  content   String   @default("")
  pdfPath   String?
  updatedAt DateTime @updatedAt
}

model ResumeVersion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  pdfPath      String
  originalName String
  size         Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model SiteSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerName   String   @default("LFen")
  heroTagline String   @default("这里是我的个人空间，记录博客、日常、心得，以及正在进行中的求职旅程。")
  updatedAt   DateTime @updatedAt
}

model GuestbookMessage {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("guestbookOwner",  fields: [ownerId],  references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("guestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model Upload {
  id           String   @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  postId       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
}
