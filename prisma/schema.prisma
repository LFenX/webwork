generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model JobApplication {
  id           String    @id @default(cuid())
  company      String
  position     String
  channel      String    @default("其他")
  appliedAt    DateTime  @default(now())
  status       String    @default("已投递")
  repliedAt    DateTime?
  notes        String?
  baseLocation String?
  hrContact    String?
  link         String?
  interviews   InterviewRecord[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InterviewRecord {
  id           String          @id @default(cuid())
  jobId        String?
  job          JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company      String
  position     String
  round        String          @default("技术一面")
  format       String          @default("视频")
  scheduledAt  DateTime        @default(now())
  interviewers String?
  questions    String?
  selfRating   Int?
  result       String          @default("待定")
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  type      String
  slug      String
  title     String
  summary   String   @default("")
  tags      String   @default("[]")
  content   String   @default("")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, slug])
  @@index([type, date])
}

model Resume {
  id        String   @id @default("singleton")
  mode      String   @default("markdown")
  content   String   @default("")
  pdfPath   String?
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default("singleton")
  ownerName   String   @default("LFen")
  heroTagline String   @default("这里是我的个人空间，记录博客、日常、心得，以及正在进行中的求职旅程。")
  updatedAt   DateTime @updatedAt
}
