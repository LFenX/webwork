generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String   @default("")
  bio          String   @default("")
  avatarText   String   @default("")
  avatarUrl    String?
  location     String   @default("")
  role         String   @default("user")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  jobs         JobApplication[]
  interviews   InterviewRecord[]
  resume       Resume?
  settings     SiteSettings?
  profile      AgentProfile?
  moduleVisibilities ModuleVisibility[]
  visitsOwned  VisitLog[] @relation("visitOwner")
  visitsMade   VisitLog[] @relation("visitVisitor")
  comments     Comment[]
  activities   UserActivity[]
  passwordChangeRequests PasswordChangeRequest[]
  uploads      Upload[]
  sessions     UserSession[]
  adminPermission AdminPermission? @relation("adminPermissionUser")
  updatedAdminPermissions AdminPermission[] @relation("adminPermissionUpdater")
  articleFolders ArticleFolder[]
  resumeVersions ResumeVersion[]

  sentRequests     FriendRequest[] @relation("sent")
  receivedRequests FriendRequest[] @relation("received")
  friendshipsA     Friendship[]    @relation("a")
  friendshipsB     Friendship[]    @relation("b")
  announcementViews AnnouncementView[]
  broadcastViews     WorldBroadcastView[]
  stickerAssets      StickerAsset[]       @relation("stickerOwner")
  uploadedStickers   StickerAsset[]       @relation("stickerUploader")
  stickerGroups      StickerGroup[]
  homeLayout         HomeLayout?
  sentChatMessages     ChatMessage[]    @relation("chatSent")
  receivedChatMessages ChatMessage[]    @relation("chatReceived")
  chatAttachments      ChatAttachment[]
  announcements        Announcement[]
  worldBroadcasts      WorldBroadcast[]
  channelMemberships   ChatChannelMember[]
  channelMessages      ChannelMessage[]
  channelAttachments   ChannelAttachment[]
  createdChannels      ChatChannel[]      @relation("channelCreator")

  guestbookOwned   GuestbookMessage[] @relation("guestbookOwner")
  guestbookWritten GuestbookMessage[] @relation("guestbookAuthor")
  aiConversations AIConversation[]
  aiMessages      AIMessage[]
  aiMessageAttachments AIMessageAttachment[]
  aiRuns          AIRun[]
  aiRunSteps      AIRunStep[]
  aiProviderConfigs AIUserProviderConfig[]
  aiAccessRequests AIAccessRequest[]
  aiUsageGrant     AIUsageGrant?
  aiToolCallLogs   AIToolCallLog[]
  aiAuditLogsOwned AIAuditLog[] @relation("aiAuditActor")
  reviewedAiAccessRequests AIAccessRequest[] @relation("aiAccessReviewer")
  grantedAiUsageGrants     AIUsageGrant[]   @relation("aiGrantCreator")
  updatedAiUsageGrants     AIUsageGrant[]   @relation("aiGrantUpdater")
  delegatedAiRuns          AIRun[]          @relation("aiRunDelegatedTarget")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  action    String
  detail    String   @default("")
  ipAddress String   @default("")
  geoLocation String @default("")
  deviceInfo String  @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model UserSession {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("active")
  ipAddress          String   @default("")
  geoLocation        String   @default("")
  deviceInfo         String   @default("")
  replacedByLocation String   @default("")
  replacedByDevice   String   @default("")
  lastSeenAt         DateTime @default(now())
  lastActiveAt       DateTime @default(now())
  lastForegroundAt   DateTime @default(now())
  lastResumeActivityAt DateTime?
  lastOfflineActivityAt DateTime?
  loggedOutAt        DateTime?
  logoutReason       String   @default("")
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([sessionId])
  @@index([lastSeenAt])
  @@index([lastForegroundAt])
  @@index([loggedOutAt])
}

model AdminPermission {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation("adminPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  approveRegistrations   Boolean  @default(false)
  approvePasswordChanges Boolean  @default(false)
  viewActivityLogs       Boolean  @default(false)
  manageUsers            Boolean  @default(false)
  manageAnnouncements    Boolean  @default(false)
  manageStickers         Boolean  @default(false)
  manageUpdateLogs       Boolean  @default(false)
  refreshGeoLocations    Boolean  @default(false)
  manageAI               Boolean  @default(false)
  updatedById            String?
  updatedBy              User?    @relation("adminPermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([updatedById])
}

model RegistrationRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  status       String    @default("pending")
  approveToken String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?
}

model PasswordChangeRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash    String
  status          String    @default("pending")
  requestedAt     DateTime  @default(now())
  respondedAt     DateTime?
  approvedById    String?

  @@index([userId, status])
  @@index([status, requestedAt])
}

model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toUserId    String
  from        User      @relation("sent",     fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("received", fields: [toUserId],   references: [id], onDelete: Cascade)
  note        String    @default("")
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("a", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("b", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  sender      User     @relation("chatSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("chatReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  replyToId   String?
  replyTo     ChatMessage?  @relation("chatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[] @relation("chatReplies")
  text        String   @default("")
  stickerId   String?
  sticker     StickerAsset? @relation("chatSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  attachments ChatAttachment[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([stickerId])
  @@index([replyToId])
}

model ChatAttachment {
  id           String      @id @default(cuid())
  messageId    String
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime    @default(now())

  @@index([messageId])
  @@index([uploaderId])
}

model Announcement {
  id                 String          @id @default(cuid())
  authorId           String
  author             User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content            String
  source             String          @default("admin")
  sourceChannelId    String?
  sourceMessageId    String?
  fromWorldChannel   Boolean         @default(false)
  createdAt          DateTime        @default(now())
  views              AnnouncementView[]

  @@index([createdAt])
  @@index([authorId])
}

model WorldBroadcast {
  id              String     @id @default(cuid())
  authorId        String
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channelId       String
  messageId       String     @unique
  content         String
  createdAt       DateTime   @default(now())
  views           WorldBroadcastView[]

  @@index([createdAt])
  @@index([authorId])
}

model WorldBroadcastView {
  id          String         @id @default(cuid())
  broadcastId String
  userId      String
  viewCount   Int            @default(0)
  hidden      Boolean        @default(false)
  lastViewedAt DateTime?
  broadcast   WorldBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId, hidden, viewCount])
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  viewCount      Int          @default(0)
  hidden         Boolean      @default(false)
  lastViewedAt   DateTime?
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, hidden, viewCount])
}

model StickerAsset {
  id          String   @id @default(cuid())
  scope       String
  ownerId     String?
  owner       User?    @relation("stickerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploaderId  String?
  uploader    User?    @relation("stickerUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  name        String   @default("")
  filename    String
  originalName String
  mimeType    String
  size        Int
  storagePath String
  isAnimated  Boolean  @default(false)
  createdAt   DateTime @default(now())
  chatMessages ChatMessage[] @relation("chatSticker")
  channelMessages ChannelMessage[] @relation("channelSticker")
  comments    Comment[] @relation("commentSticker")
  guestbookMessages GuestbookMessage[] @relation("guestbookSticker")
  groupEntries StickerGroupEntry[]

  @@index([scope, createdAt])
  @@index([ownerId, createdAt])
}

model StickerGroup {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  scope     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   StickerGroupEntry[]

  @@unique([ownerId, name, scope])
  @@index([ownerId, scope, sortOrder])
}

model StickerGroupEntry {
  id        String       @id @default(cuid())
  groupId   String
  group     StickerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stickerId String
  sticker   StickerAsset  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([groupId, stickerId])
  @@index([stickerId])
}

model HomeLayout {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ChatChannel {
  id          String              @id @default(cuid())
  type        String              @default("group")
  name        String
  announcement String             @default("")
  createdById String?
  createdBy   User?               @relation("channelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ChatChannelMember[]
  messages    ChannelMessage[]

  @@index([type])
  @@index([createdById])
}

model ChatChannelMember {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  role      String      @default("member")
  joinedAt  DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChannelMessage {
  id          String              @id @default(cuid())
  channelId   String
  senderId    String
  channel     ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyToId   String?
  replyTo     ChannelMessage?     @relation("channelReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChannelMessage[]    @relation("channelReplies")
  text        String              @default("")
  stickerId   String?
  sticker     StickerAsset?       @relation("channelSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  createdAt   DateTime            @default(now())
  attachments ChannelAttachment[]

  @@index([channelId, createdAt])
  @@index([senderId, createdAt])
  @@index([stickerId])
  @@index([replyToId])
}

model ChannelAttachment {
  id           String         @id @default(cuid())
  messageId    String
  message      ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime       @default(now())

  @@index([messageId])
  @@index([uploaderId])
}

model JobApplication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String
  position     String
  channel      String    @default("其他")
  appliedAt    DateTime  @default(now())
  status       String    @default("已投递")
  repliedAt    DateTime?
  notes        String?
  baseLocation String?
  hrContact    String?
  link         String?
  interviews   InterviewRecord[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model InterviewRecord {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company      String
  position     String
  round        String          @default("技术一面")
  format       String          @default("视频")
  scheduledAt  DateTime        @default(now())
  interviewers String?
  questions    String?
  selfRating   Int?
  result       String          @default("待定")
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model Post {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     ArticleFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  type       String
  slug       String
  title      String
  summary    String   @default("")
  tags       String   @default("[]")
  content    String   @default("")
  visibility String   @default("private")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]

  @@unique([userId, type, slug])
  @@index([userId, type, date])
  @@index([folderId])
}

model ArticleFolder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  name          String
  description   String   @default("")
  coverImageUrl String   @default("")
  coverPositionX Int     @default(50)
  coverPositionY Int     @default(50)
  coverOpacity   Int     @default(100)
  coverFitMode   String  @default("auto")
  coverScale     Int     @default(100)
  posts         Post[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, type])
}

model UpdateLogOverride {
  hash          String   @id
  customMessage String?
  useOriginal   Boolean  @default(true)
  hidden        Boolean  @default(false)
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model ModuleVisibility {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  visibility String   @default("private")
  updatedAt  DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

model VisitLog {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("visitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  visitorId String?
  visitor   User?    @relation("visitVisitor", fields: [visitorId], references: [id], onDelete: SetNull)
  module    String
  path      String
  postId    String?
  createdAt DateTime @default(now())

  @@index([ownerId, module, createdAt])
  @@index([visitorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("commentReplies")
  content   String
  stickerId   String?
  sticker     StickerAsset? @relation("commentSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([stickerId])
}

model Resume {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("markdown")
  content   String   @default("")
  pdfPath   String?
  updatedAt DateTime @updatedAt
}

model ResumeVersion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  pdfPath      String
  originalName String
  size         Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model SiteSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerName   String   @default("LFen")
  heroTagline String   @default("这里是我的个人空间，记录博客、日常、心得，以及正在进行中的求职旅程。")
  language    String   @default("zh-CN")
  updatedAt   DateTime @updatedAt
}

model AgentProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)

  soulContent       String   @default("")
  soulVersion       Int      @default(1)

  identityContent   String   @default("")
  identityVersion   Int      @default(1)

  userContextContent String  @default("")
  userContextVersion Int     @default(1)

  rulesContent      String   @default("")
  rulesVersion      Int      @default(1)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GuestbookMessage {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("guestbookOwner",  fields: [ownerId],  references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("guestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    GuestbookMessage? @relation("guestbookReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   GuestbookMessage[] @relation("guestbookReplies")
  content   String
  stickerId   String?
  sticker     StickerAsset? @relation("guestbookSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([parentId])
  @@index([stickerId])
}

model Upload {
  id           String   @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  postId       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiMessageAttachments AIMessageAttachment[]

  @@index([userId])
  @@index([postId])
}

model AIConversation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String      @default("New conversation")
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  messages      AIMessage[]
  toolCallLogs  AIToolCallLog[]
  runs          AIRun[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt, lastMessageAt])
}

model AIMessage {
  id                String         @id @default(cuid())
  conversationId    String
  conversation      AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String
  contentMarkdown   String         @default("")
  status            String         @default("completed")
  reasoningSummary  String         @default("")
  toolTraceSummary  String         @default("")
  modelName         String         @default("")
  providerSource    String         @default("none")
  createdAt         DateTime       @default(now())
  runRecord         AIRun?         @relation("AIMessageRun")
  toolCallLogs      AIToolCallLog[]
  runSteps          AIRunStep[]
  attachments       AIMessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model AIMessageAttachment {
  id             String    @id @default(cuid())
  messageId      String
  message        AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId       String?
  upload         Upload?   @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  originalName   String
  mimeType       String
  size           Int
  url            String
  createdAt      DateTime  @default(now())

  @@index([messageId])
  @@index([userId, createdAt])
  @@index([uploadId])
}

model AIUserProviderConfig {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String   @default("")
  isActive        Boolean  @default(false)
  providerType    String   @default("openai-compatible")
  providerLabel   String   @default("")
  baseUrl         String   @default("")
  apiKeyEncrypted String   @default("")
  apiKeyMask      String   @default("")
  model           String   @default("")
  temperature     Float    @default(0.7)
  streamEnabled   Boolean  @default(true)
  isEnabled       Boolean  @default(true)
  modelList       String   @default("[]")
  lastTestedAt    DateTime?
  lastTestStatus  String   @default("unknown")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model AIAccessRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("pending")
  message      String   @default("")
  reviewedById String?
  reviewedBy   User?    @relation("aiAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String   @default("")
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById, reviewedAt])
}

model AIUsageGrant {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("active")
  providerLabel   String   @default("")
  baseUrl         String   @default("")
  apiKeyEncrypted String   @default("")
  apiKeyMask      String   @default("")
  model           String   @default("")
  temperature     Float    @default(0.7)
  streamEnabled   Boolean  @default(true)
  modelList       String   @default("[]")
  grantedById     String
  grantedBy       User     @relation("aiGrantCreator", fields: [grantedById], references: [id], onDelete: Restrict)
  updatedById     String?
  updatedBy       User?    @relation("aiGrantUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  revokedAt       DateTime?

  @@index([status, updatedAt])
  @@index([grantedById, createdAt])
  @@index([updatedById, updatedAt])
}

model AIToolCallLog {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        AIMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName       String
  toolInputJson  Json
  toolResultJson Json?
  status         String         @default("completed")
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([conversationId, startedAt])
  @@index([messageId, startedAt])
  @@index([userId, startedAt])
}

model AIRun {
  id                String      @id @default(cuid())
  conversationId    String
  conversation      AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId         String      @unique
  message           AIMessage   @relation("AIMessageRun", fields: [messageId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt            String      @default("")
  mode              String      @default("self")
  delegatedTargetUserId String?
  delegatedTargetUser User?     @relation("aiRunDelegatedTarget", fields: [delegatedTargetUserId], references: [id], onDelete: SetNull)
  plannerModel      String      @default("")
  finalModel        String      @default("")
  status            String      @default("running")
  summary           String      @default("")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  finishedAt        DateTime?
  steps             AIRunStep[]

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@index([delegatedTargetUserId, createdAt])
}

model AIRunStep {
  id             String   @id @default(cuid())
  runId          String
  run            AIRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  messageId      String
  message        AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  status         String   @default("running")
  summary        String   @default("")
  inputPreview   Json?
  outputPreview  Json?
  errorMessage   String   @default("")
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  orderIndex     Int      @default(0)

  @@index([runId, startedAt])
  @@index([messageId, startedAt])
  @@index([userId, startedAt])
}

model AIAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("aiAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  action      String
  detail      String   @default("")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}
