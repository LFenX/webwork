generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String   @default("")
  bio          String   @default("")
  avatarText   String   @default("")
  avatarUrl    String?
  location     String   @default("")
  role         String   @default("user")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  jobs         JobApplication[]
  interviews   InterviewRecord[]
  resume       Resume?
  settings     SiteSettings?
  profile      AgentProfile?
  moduleVisibilities ModuleVisibility[]
  visitsOwned  VisitLog[] @relation("visitOwner")
  visitsMade   VisitLog[] @relation("visitVisitor")
  comments     Comment[]
  activities   UserActivity[]
  passwordChangeRequests PasswordChangeRequest[]
  uploads      Upload[]
  sessions     UserSession[]
  adminPermission AdminPermission? @relation("adminPermissionUser")
  updatedAdminPermissions AdminPermission[] @relation("adminPermissionUpdater")
  articleFolders ArticleFolder[]
  resumeVersions ResumeVersion[]

  sentRequests     FriendRequest[] @relation("sent")
  receivedRequests FriendRequest[] @relation("received")
  friendshipsA     Friendship[]    @relation("a")
  friendshipsB     Friendship[]    @relation("b")
  announcementViews AnnouncementView[]
  broadcastViews     WorldBroadcastView[]
  stickerAssets      StickerAsset[]       @relation("stickerOwner")
  uploadedStickers   StickerAsset[]       @relation("stickerUploader")
  stickerGroups      StickerGroup[]
  homeLayout         HomeLayout?
  sentChatMessages     ChatMessage[]    @relation("chatSent")
  receivedChatMessages ChatMessage[]    @relation("chatReceived")
  chatAttachments      ChatAttachment[]
  announcements        Announcement[]
  worldBroadcasts      WorldBroadcast[]
  channelMemberships   ChatChannelMember[]
  channelMessages      ChannelMessage[]
  channelAttachments   ChannelAttachment[]
  createdChannels      ChatChannel[]      @relation("channelCreator")

  guestbookOwned   GuestbookMessage[] @relation("guestbookOwner")
  guestbookWritten GuestbookMessage[] @relation("guestbookAuthor")
  aiConversations AIConversation[]
  aiMessages      AIMessage[]
  aiMessageAttachments AIMessageAttachment[]
  aiRuns          AIRun[]
  aiRunSteps      AIRunStep[]
  aiProviderConfigs AIUserProviderConfig[]
  aiAccessRequests AIAccessRequest[]
  aiUsageGrant     AIUsageGrant?
  aiToolCallLogs   AIToolCallLog[]
  aiWebSearchToolLogs AIWebSearchToolLog[]
  aiUsageLogs      AIUsageLog[]
  aiAuditLogsOwned AIAuditLog[] @relation("aiAuditActor")
  reviewedAiAccessRequests AIAccessRequest[] @relation("aiAccessReviewer")
  grantedAiUsageGrants     AIUsageGrant[]   @relation("aiGrantCreator")
  updatedAiUsageGrants     AIUsageGrant[]   @relation("aiGrantUpdater")
  delegatedAiRuns          AIRun[]          @relation("aiRunDelegatedTarget")
  memoryFacts              MemoryFact[]
  memoryEvents             MemoryEvent[]
  memoryToolEvents         MemoryToolEvent[]
  memorySettings           MemorySettings?
  autoReplySettings        AutoReplySetting[]
  autoReplyLogs            AutoReplyLog[]
  websiteResources         WebsiteResource[]
  websiteFolders           WebsiteFolder[]
  websiteVisits            WebsiteVisitLog[]
  sqlAccessGrant           SqlAccessGrant?      @relation("sqlGrantUser")
  updatedSqlAccessGrants   SqlAccessGrant[]     @relation("sqlGrantUpdater")
  sqlSavedQueries          SqlSavedQuery[]
  sqlAuditLogs             SqlAuditLog[]
  sqlPrivateFolders        SqlPrivateFolder[]
  sqlPrivateTables         SqlPrivateTable[]
  sqlAssistantConversations SqlAssistantConversation[]
  sqlAssistantMessages      SqlAssistantMessage[]
  updatedSqlTableCatalogOverrides SqlTableCatalogOverride[] @relation("sqlCatalogOverrideUpdater")
  guardianProfile GuardianProfile?
  guardianEvents  GuardianEvent[]
}

model SoulWingRoundtableSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(true)
  morningEnabled Boolean  @default(true)
  eveningEnabled Boolean  @default(true)
  morningTime    String   @default("07:00")
  eveningTime    String   @default("21:00")
  timezone       String   @default("Asia/Shanghai")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SoulWingRoundtableDay {
  id                 String   @id @default(cuid())
  dateKey            String   @unique
  morningTitle       String
  morningDescription String   @default("")
  eveningTitle       String
  eveningDescription String   @default("")
  dutyUserId         String?
  materialCard       Json?
  announcement       String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([dateKey])
  @@index([dutyUserId])
}

model SoulWingRoundtableDiscussion {
  id               String    @id @default(cuid())
  dateKey          String
  slot             String
  topicTitle       String
  topicDescription String    @default("")
  topicType        String    @default("custom")
  materialCard     Json?
  status           String    @default("pending")
  source           String    @default("auto")
  initiatedById    String?
  dutyUserId       String?
  summary          Json?
  errorMessage     String    @default("")
  scheduledAt      DateTime?
  plannedTurns     Int       @default(0)
  completedTurns   Int       @default(0)
  styleConfig      Json?
  nextTurnAt       DateTime?
  generationLockedAt DateTime?
  generationLockToken String?
  runningKey       String?   @unique
  slotClaimKey     String?   @unique
  lastMessageAt    DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         SoulWingRoundtableMessage[]

  @@index([dateKey, slot])
  @@index([status, createdAt])
  @@index([status, nextTurnAt])
  @@index([generationLockedAt])
  @@index([dutyUserId])
  @@index([deletedAt, createdAt])
}

model SoulWingRoundtableMessage {
  id             String   @id @default(cuid())
  discussionId   String
  discussion     SoulWingRoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorUserId   String?
  authorName     String
  authorAvatarUrl String?
  kind           String   @default("agent")
  round          Int      @default(0)
  text           String
  userProvided   Boolean  @default(false)
  metadata       Json?
  followupKey    String?  @unique
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([discussionId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([deletedAt, createdAt])
}

model SoulWingRoundtableParticipant {
  id            String   @id @default(cuid())
  userId        String   @unique
  enabled       Boolean  @default(true)
  adminPaused   Boolean  @default(false)
  pausedById    String?
  pauseReason   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, adminPaused])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  action    String
  detail    String   @default("")
  ipAddress String   @default("")
  geoLocation String @default("")
  deviceInfo String  @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model UserSession {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("active")
  ipAddress          String   @default("")
  geoLocation        String   @default("")
  deviceInfo         String   @default("")
  replacedByLocation String   @default("")
  replacedByDevice   String   @default("")
  lastSeenAt         DateTime @default(now())
  lastActiveAt       DateTime @default(now())
  lastForegroundAt   DateTime @default(now())
  lastResumeActivityAt DateTime?
  lastOfflineActivityAt DateTime?
  loggedOutAt        DateTime?
  logoutReason       String   @default("")
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([sessionId])
  @@index([lastSeenAt])
  @@index([lastForegroundAt])
  @@index([loggedOutAt])
}

model AdminPermission {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation("adminPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  approveRegistrations   Boolean  @default(false)
  approvePasswordChanges Boolean  @default(false)
  viewActivityLogs       Boolean  @default(false)
  manageUsers            Boolean  @default(false)
  manageAnnouncements    Boolean  @default(false)
  manageStickers         Boolean  @default(false)
  manageUpdateLogs       Boolean  @default(false)
  refreshGeoLocations    Boolean  @default(false)
  manageAI               Boolean  @default(false)
  manageSqlLab           Boolean  @default(false)
  updatedById            String?
  updatedBy              User?    @relation("adminPermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([updatedById])
}

model RegistrationRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  status       String    @default("pending")
  approveToken String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?
}

model PasswordChangeRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash    String
  status          String    @default("pending")
  requestedAt     DateTime  @default(now())
  respondedAt     DateTime?
  approvedById    String?

  @@index([userId, status])
  @@index([status, requestedAt])
}

model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toUserId    String
  from        User      @relation("sent",     fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("received", fields: [toUserId],   references: [id], onDelete: Cascade)
  note        String    @default("")
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("a", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("b", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  sender      User     @relation("chatSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("chatReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  replyToId   String?
  replyTo     ChatMessage?  @relation("chatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[] @relation("chatReplies")
  text        String   @default("")
  stickerId   String?
  sticker     StickerAsset? @relation("chatSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  attachments ChatAttachment[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([stickerId])
  @@index([replyToId])
}

model ChatAttachment {
  id           String      @id @default(cuid())
  messageId    String
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime    @default(now())

  @@index([messageId])
  @@index([uploaderId])
}

model Announcement {
  id                 String          @id @default(cuid())
  authorId           String
  author             User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content            String
  source             String          @default("admin")
  sourceChannelId    String?
  sourceMessageId    String?
  fromWorldChannel   Boolean         @default(false)
  createdAt          DateTime        @default(now())
  views              AnnouncementView[]

  @@index([createdAt])
  @@index([authorId])
}

model WorldBroadcast {
  id              String     @id @default(cuid())
  authorId        String
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channelId       String
  messageId       String     @unique
  content         String
  createdAt       DateTime   @default(now())
  views           WorldBroadcastView[]

  @@index([createdAt])
  @@index([authorId])
}

model WorldBroadcastView {
  id          String         @id @default(cuid())
  broadcastId String
  userId      String
  viewCount   Int            @default(0)
  hidden      Boolean        @default(false)
  lastViewedAt DateTime?
  broadcast   WorldBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId, hidden, viewCount])
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  viewCount      Int          @default(0)
  hidden         Boolean      @default(false)
  lastViewedAt   DateTime?
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, hidden, viewCount])
}

model StickerAsset {
  id          String   @id @default(cuid())
  scope       String
  ownerId     String?
  owner       User?    @relation("stickerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploaderId  String?
  uploader    User?    @relation("stickerUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  name        String   @default("")
  filename    String
  originalName String
  mimeType    String
  size        Int
  storagePath String
  isAnimated  Boolean  @default(false)
  createdAt   DateTime @default(now())
  chatMessages ChatMessage[] @relation("chatSticker")
  channelMessages ChannelMessage[] @relation("channelSticker")
  comments    Comment[] @relation("commentSticker")
  guestbookMessages GuestbookMessage[] @relation("guestbookSticker")
  groupEntries StickerGroupEntry[]

  @@index([scope, createdAt])
  @@index([ownerId, createdAt])
}

model StickerGroup {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  scope     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   StickerGroupEntry[]

  @@unique([ownerId, name, scope])
  @@index([ownerId, scope, sortOrder])
}

model StickerGroupEntry {
  id        String       @id @default(cuid())
  groupId   String
  group     StickerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stickerId String
  sticker   StickerAsset  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([groupId, stickerId])
  @@index([stickerId])
}

model HomeLayout {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ChatChannel {
  id          String              @id @default(cuid())
  type        String              @default("group")
  name        String
  announcement String             @default("")
  createdById String?
  createdBy   User?               @relation("channelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ChatChannelMember[]
  messages    ChannelMessage[]

  @@index([type])
  @@index([createdById])
}

model ChatChannelMember {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  role      String      @default("member")
  joinedAt  DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChannelMessage {
  id          String              @id @default(cuid())
  channelId   String
  senderId    String
  channel     ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyToId   String?
  replyTo     ChannelMessage?     @relation("channelReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChannelMessage[]    @relation("channelReplies")
  text        String              @default("")
  stickerId   String?
  sticker     StickerAsset?       @relation("channelSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  createdAt   DateTime            @default(now())
  attachments ChannelAttachment[]

  @@index([channelId, createdAt])
  @@index([senderId, createdAt])
  @@index([stickerId])
  @@index([replyToId])
}

model ChannelAttachment {
  id           String         @id @default(cuid())
  messageId    String
  message      ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime       @default(now())

  @@index([messageId])
  @@index([uploaderId])
}

model JobApplication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String
  position     String
  channel      String    @default("其他")
  appliedAt    DateTime  @default(now())
  status       String    @default("已投递")
  repliedAt    DateTime?
  notes        String?
  baseLocation String?
  hrContact    String?
  link         String?
  interviews   InterviewRecord[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model InterviewRecord {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company      String
  position     String
  round        String          @default("技术一面")
  format       String          @default("视频")
  scheduledAt  DateTime        @default(now())
  interviewers String?
  questions    String?
  selfRating   Int?
  result       String          @default("待定")
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model Post {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     ArticleFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  type       String
  slug       String
  title      String
  summary    String   @default("")
  tags       String   @default("[]")
  content    String   @default("")
  visibility String   @default("private")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]

  @@unique([userId, type, slug])
  @@index([userId, type, date])
  @@index([folderId])
}

model ArticleFolder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  name          String
  description   String   @default("")
  coverImageUrl String   @default("")
  coverPositionX Int     @default(50)
  coverPositionY Int     @default(50)
  coverOpacity   Int     @default(100)
  coverFitMode   String  @default("auto")
  coverScale     Int     @default(100)
  posts         Post[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, type])
}

model UpdateLogOverride {
  hash          String   @id
  customMessage String?
  useOriginal   Boolean  @default(true)
  hidden        Boolean  @default(false)
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model ModuleVisibility {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  visibility String   @default("private")
  updatedAt  DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

model VisitLog {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("visitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  visitorId String?
  visitor   User?    @relation("visitVisitor", fields: [visitorId], references: [id], onDelete: SetNull)
  module    String
  path      String
  postId    String?
  createdAt DateTime @default(now())

  @@index([ownerId, module, createdAt])
  @@index([visitorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("commentReplies")
  content   String
  stickerId   String?
  sticker     StickerAsset? @relation("commentSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  stickerEmoji String?
  ipAddress String @default("")
  geoLocation String @default("")
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([stickerId])
}

model Resume {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("markdown")
  content   String   @default("")
  pdfPath   String?
  updatedAt DateTime @updatedAt

  resumeJson          Json?
  selectedTheme       String?
  lastExportedPdfPath String?
  lastExportedAt      DateTime?

  renderedHtml       String?
  lastBuiltAt        DateTime?
  lastBuiltTheme     String?
  resumeLocale       String?
  resumeAppearance   String?
  resumeConfig       Json?
  lastBuiltConfigHash String?
}

model ResumeTemplateConfig {
  slug              String   @id
  pkg               String
  enabled           Boolean  @default(true)
  category          String   @default("en")
  sortOrder         Int      @default(1000)
  displayName       String?
  description       String?
  defaultLocale     String?
  defaultAppearance String?
  defaultConfig     Json?
  updatedById       String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([category, sortOrder])
  @@index([enabled])
}

model ResumeTemplateAuditLog {
  id        String   @id @default(cuid())
  slug      String
  actorId   String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
}

model ResumeVersion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  pdfPath      String
  originalName String
  size         Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model SiteSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerName   String   @default("LFen")
  heroTagline String   @default("这里是我的个人空间，记录博客、日常、心得，以及正在进行中的求职旅程。")
  language    String   @default("zh-CN")
  updatedAt   DateTime @updatedAt
}

model AgentProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)

  soulContent       String   @default("")
  soulVersion       Int      @default(1)

