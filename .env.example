# PostgreSQL. Do not commit real passwords in .env files.
# Example local database: webappwork_dev on localhost:5432.
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/webappwork_dev?schema=public"
POSTGRES_PASSWORD="replace-with-local-password"

# Optional legacy source used by scripts/migrate-sqlite-to-postgres.ts.
SQLITE_DATABASE_URL="file:./dev.db"

# Auth
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_USER_ID=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-only-for-local-bootstrap"
ADMIN_DISPLAY_NAME="Admin"
AI_SECRET_KEY="replace-with-32-byte-base64-or-long-random-secret"

# PDF parsing
PDF_PARSER_PYTHON=".venv-pdf\\Scripts\\python.exe"
PDF_PARSE_QUALITY="highest"
PDF_PARSE_TIMEOUT_MS="600000"
PDF_MAX_PAGES="300"
PDF_CONTEXT_MAX_CHARS="14000"
# Optional MinerU adapter command. Keep {input} and {output} placeholders.
PDF_MINERU_COMMAND=""
